# ===========================================================================
# Terraform
# ===========================================================================
# Local cache + downloaded provider plugins (regenerated by `terraform init`)
**/.terraform/*

# State files 
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Saved plan files
*.tfplan
tfplan*
plan-*.txt
plan-*.json
plan-output*

# Local-only override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# tfvars are ignored by default (they can hold secrets), but our per-environment
# files are deliberately tracked — they contain only sizing, no secrets.
*.tfvars
*.tfvars.json
!envs/*.tfvars

# ===========================================================================
# Secrets & credentials 
# ===========================================================================
*_credentials.csv
*accessKeys*.csv
*.pem
.env
.env.*

# ===========================================================================
# OS / editor noise
# ===========================================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

